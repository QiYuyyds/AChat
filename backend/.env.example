# AChat Python Backend Environment Variables

# ═══════════════════════════════════════════════════════════
# Database (PostgreSQL)
# ═══════════════════════════════════════════════════════════
DATABASE_URL=postgresql+asyncpg://agenthub:agenthub@localhost:5432/agenthub

# ═══════════════════════════════════════════════════════════
# API Keys (optional, can also be set in app settings)
# ═══════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Used as env-fallback when guide agent provider=deepseek and agent.api_key
# is NULL (see GUIDE_AGENT_* below to switch the guide agent to another
# provider such as LongCat).
DEEPSEEK_API_KEY=
ARK_API_KEY=

# ═══════════════════════════════════════════════════════════
# Guide Agent (小A) LLM Configuration
# ═══════════════════════════════════════════════════════════
# The builtin guide agent's LLM is fully configurable here. Defaults to
# DeepSeek for backward compat. To use LongCat instead:
#   GUIDE_AGENT_MODEL_PROVIDER=openai-compatible
#   GUIDE_AGENT_MODEL_ID=LongCat-2.0
#   GUIDE_AGENT_API_KEY=ak_xxx
#   GUIDE_AGENT_API_BASE_URL=https://api.longcat.chat/openai
# Note: these only apply at seed time (first startup). To change an
# existing guide agent, PATCH /api/agents/ag_guide_builtin.
GUIDE_AGENT_MODEL_PROVIDER=deepseek
GUIDE_AGENT_MODEL_ID=deepseek-v4-flash
GUIDE_AGENT_API_KEY=
GUIDE_AGENT_API_BASE_URL=

# ═══════════════════════════════════════════════════════════
# Web Search (Tavily)
# ═══════════════════════════════════════════════════════════
# Required for the web_search tool. Leave empty to disable web search
# (the tool returns a clear error when called without a key).
TAVILY_API_KEY=

# ═══════════════════════════════════════════════════════════
# Server
# ═══════════════════════════════════════════════════════════
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ═══════════════════════════════════════════════════════════
# CORS (for frontend)
# ═══════════════════════════════════════════════════════════
CORS_ORIGINS=http://localhost:3000

# ═══════════════════════════════════════════════════════════
# Workspace & Data Directory
# ═══════════════════════════════════════════════════════════
WORKSPACE_ROOT=../.agenthub-data/workspaces
DATA_DIR=../.agenthub-data

# ═══════════════════════════════════════════════════════════
# Milvus (Vector Database)
# ═══════════════════════════════════════════════════════════
# Leave empty to disable Milvus (degraded to TF cosine memory search)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ═══════════════════════════════════════════════════════════
# Elasticsearch (Full-Text Search)
# ═══════════════════════════════════════════════════════════
# Leave empty to disable ES (no full-text retrieval)
ES_ADDRESSES=http://localhost:9200

# ═══════════════════════════════════════════════════════════
# Neo4j (Knowledge Graph)
# ═══════════════════════════════════════════════════════════
# Leave empty to disable Neo4j (GraphMemory becomes no-op)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
ENABLE_GRAPH=false
KG_MAX_HOPS=2
KG_WEIGHT=0.3

# ═══════════════════════════════════════════════════════════
# Kafka (Optional Event Bus Enhancement)
# ═══════════════════════════════════════════════════════════
# Leave empty to use InProcess EventBus only
KAFKA_BROKERS=localhost:9092

# ═══════════════════════════════════════════════════════════
# Redis (Optional — Metadata Cache + Async DB Writes)
# ═══════════════════════════════════════════════════════════
# Deploy Redis locally (same machine as backend) for best latency (~1ms RTT).
# When configured: low-churn metadata (Agent/Settings/Workspace) is cached in Redis,
# and per-token DB writes are buffered in Redis Streams for batch flush.
# When empty or unreachable: system falls back to synchronous PostgreSQL behavior.
REDIS_URL=

# ═══════════════════════════════════════════════════════════
# Embedding Model Configuration
# ═══════════════════════════════════════════════════════════
# Required for semantic search (Milvus/LTM recall)
EMBEDDING_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=

# ═══════════════════════════════════════════════════════════
# RAG System Configuration
# ═══════════════════════════════════════════════════════════
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_RRF_CONSTANT_K=60
RAG_SEMANTIC_WEIGHT=0.7
RAG_MILVUS_DIM=1024
RAG_REWRITE_ENABLED=true
RAG_REWRITE_NUM_QUERIES=3
RAG_RERANK_ENABLED=true
RAG_RERANK_PREVIEW_LEN=200

# ═══════════════════════════════════════════════════════════
# Memory System Configuration
# ═══════════════════════════════════════════════════════════
MEMORY_SHORT_TERM_MAX_TURNS=10
MEMORY_LONG_TERM_TOP_K=3
MEMORY_CONSOLIDATION_SIMILARITY=0.80
MEMORY_CONSOLIDATION_DEDUP=0.95
MEMORY_CONSOLIDATION_TTL_DAYS=30
MEMORY_CONSOLIDATION_DECAY_RATE=0.995
MEMORY_CONSOLIDATION_MIN_IMPORTANCE=0.3
MEMORY_CONSOLIDATION_TRIGGER=5

# ═══════════════════════════════════════════════════════════
# Authentication (JWT + bcrypt)
# ═══════════════════════════════════════════════════════════
# JWT signing secret — MUST be at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Access token expiry (seconds). Default: 3600 (1 hour)
JWT_ACCESS_TOKEN_EXPIRY=3600

# Refresh token expiry (seconds). Default: 604800 (7 days)
JWT_REFRESH_TOKEN_EXPIRY=604800

# Enable the password-only VIP shortcut on the login page and auth API
VIP_LOGIN_ENABLED=true

# Allow new user registration via /api/auth/register
ALLOW_REGISTRATION=true

# Default user for migration and VIP shortcut login
DEFAULT_USER_EMAIL=admin@local
DEFAULT_USER_PASSWORD=123456
# After changing the password, run:
# python -m scripts.reset_default_user_password

# ═══════════════════════════════════════════════════════════
# ReAct Loop (Custom SDK agents)
# ═══════════════════════════════════════════════════════════
# Enable the five-stage in-memory compaction pipeline (stages 1/2/3 at
# 0.70/0.80/0.88 ratios). Set to false to fall back to the legacy single-point
# _mid_run_compact (0.85 ratio, recent_keep=6, len-based success).
COMPACT_PIPELINE_ENABLED=true

# ═══════════════════════════════════════════════════════════
# Observability (OpenTelemetry + Arize Phoenix)
# ═══════════════════════════════════════════════════════════
# Enable/disable trace collection (all spans become no-op when false)
TRACE_ENABLED=true

# Phoenix OTLP gRPC endpoint (where spans are sent)
PHOENIX_ENDPOINT=http://localhost:4317

# Phoenix Web UI URL (for reference / linking)
PHOENIX_UI_URL=http://localhost:6006

# Online rule-based evaluation (runs automatically after each agent run)
EVAL_RULE_ENABLED=true

# Offline LLM-as-judge evaluation (manually triggered via API)
EVAL_JUDGE_ENABLED=false

# ─── Obsidian Sync ───
# Maximum transclusion depth for ![[note]] embedding
OBSIDIAN_MAX_EMBED_DEPTH=2
