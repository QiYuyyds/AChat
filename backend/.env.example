# AChat Python Backend Environment Variables

# ═══════════════════════════════════════════════════════════
# Database (PostgreSQL — remote, always required)
# ═══════════════════════════════════════════════════════════
DATABASE_URL=postgresql+asyncpg://agenthub:agenthub@localhost:5432/agenthub

# ═══════════════════════════════════════════════════════════
# Database (Local SQLite — dual-DB mode)
# ═══════════════════════════════════════════════════════════
# When set, 10 conversation/config tables are stored in local SQLite
# (messages, conversations, agent_runs, agents, etc.) for <1ms write
# latency and data privacy. When empty, all tables go to PostgreSQL.
# Example: sqlite+aiosqlite:///../.agenthub-data/agenthub.db
DATABASE_LOCAL_URL=

# ═══════════════════════════════════════════════════════════
# API Keys (optional, can also be set in app settings)
# ═══════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Used as env-fallback when guide agent provider=deepseek and GUIDE_AGENT_API_KEY
# is NULL (see GUIDE_AGENT_* below to switch the guide agent to another
# provider such as LongCat).
DEEPSEEK_API_KEY=
ARK_API_KEY=

# ═══════════════════════════════════════════════════════════
# Guide Agent (小A) LLM Configuration
# ═══════════════════════════════════════════════════════════
# The builtin guide agent's LLM is fully configurable here. Defaults to
# DeepSeek for backward compat. To use LongCat instead:
#   GUIDE_AGENT_MODEL_PROVIDER=openai-compatible
#   GUIDE_AGENT_MODEL_ID=LongCat-2.0
#   GUIDE_AGENT_API_KEY=ak_xxx
#   GUIDE_AGENT_API_BASE_URL=https://api.longcat.chat/openai
# Note: these only apply at seed time (first startup). To change an
# existing guide agent, PATCH /api/agents/ag_guide_builtin.
GUIDE_AGENT_MODEL_PROVIDER=deepseek
GUIDE_AGENT_MODEL_ID=deepseek-v4-flash
GUIDE_AGENT_API_KEY=
GUIDE_AGENT_API_BASE_URL=

# ═══════════════════════════════════════════════════════════
# Web Search (Tavily)
# ═══════════════════════════════════════════════════════════
# Required for the web_search tool. Leave empty to disable web search
# (the tool returns a clear error when called without a key).
TAVILY_API_KEY=

# ═══════════════════════════════════════════════════════════
# Server
# ═══════════════════════════════════════════════════════════
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ═══════════════════════════════════════════════════════════
# CORS (for frontend)
# ═══════════════════════════════════════════════════════════
CORS_ORIGINS=http://localhost:3000

# ═══════════════════════════════════════════════════════════
# Workspace & Data Directory
# ═══════════════════════════════════════════════════════════
WORKSPACE_ROOT=../.agenthub-data/workspaces
DATA_DIR=../.agenthub-data

# ═══════════════════════════════════════════════════════════
# Milvus (Vector Database)
# ═══════════════════════════════════════════════════════════
# Leave empty to disable Milvus (degraded to TF cosine memory search)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ═══════════════════════════════════════════════════════════
# Neo4j (Knowledge Graph — RAG KGStore only, not memory system)
# ═══════════════════════════════════════════════════════════
# Leave empty to disable Neo4j (KGStore becomes no-op, RAG degrades to BM25+vector only)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
ENABLE_GRAPH=false
KG_MAX_HOPS=2
KG_WEIGHT=0.0

# ═══════════════════════════════════════════════════════════
# Kafka (Optional Event Bus Enhancement)
# ═══════════════════════════════════════════════════════════
# Leave empty to use InProcess EventBus only
KAFKA_BROKERS=localhost:9092

# ═══════════════════════════════════════════════════════════
# Redis (Removed — replaced by local SQLite + process-internal cache)
# ═══════════════════════════════════════════════════════════
# Redis is no longer used. KV cache is replaced by process-internal dict
# with TTL. Stream write-behind is replaced by direct SQLite writes.
# This setting is kept for backward compatibility but has no effect.
# REDIS_URL=

# ═══════════════════════════════════════════════════════════
# Embedding Model Configuration
# ═══════════════════════════════════════════════════════════
# Required for semantic search (Milvus/RAG recall)
EMBEDDING_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=

# ═══════════════════════════════════════════════════════════
# RAG System Configuration
# ═══════════════════════════════════════════════════════════
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_RRF_CONSTANT_K=60
RAG_SEMANTIC_WEIGHT=0.7
RAG_KEYWORD_WEIGHT=0.3
RAG_MILVUS_DIM=1024
RAG_RERANK_ENABLED=true
RAG_RERANK_PREVIEW_LEN=200

# Extract embedded images from DOCX/PPTX/PDF during parsing
RAG_EXTRACT_IMAGES=true

# Generate LLM captions for extracted images (uses LLM_API_KEY/LLM_API_URL/LLM_MODEL)
RAG_IMAGE_CAPTION_ENABLED=false

# ═══════════════════════════════════════════════════════════
# OCR Engine Configuration
# ═══════════════════════════════════════════════════════════
# Default OCR engine: 'auto' (first available) | 'none' | 'rapidocr' | 'mineru' |
#   'mineru_official' | 'deepseek_ocr' | 'pp_structure_v3' | 'paddleocr_vl' | 'paddleocr_pp_ocrv6'
OCR_ENGINE=auto

# RapidOCR — local OCR (requires 'rapidocr' package, PP-OCRv5)
OCR_RAPID_OCR_PATH=

# MinerU self-hosted — URL of the MinerU service
OCR_MINERU_URL=

# MinerU Official cloud — API key from https://mineru.net
OCR_MINERU_OFFICIAL_KEY=

# DeepSeek-OCR via SiliconFlow — API key from https://siliconflow.cn
# Uses model 'deepseek-ai/DeepSeek-OCR', converts documents to Markdown
OCR_DEEPSEEK_OCR_KEY=

# PP-Structure-V3 via PaddleX — URL of the PaddleX service
OCR_PP_STRUCTURE_URL=http://localhost:8080

# PaddleOCR cloud API — API token from https://aistudio.baidu.com
OCR_PADDLEOCR_KEY=

# RAG Task Queue (async worker for parse/ingest/graph_build tasks)
# Worker polling interval in seconds
RAG_TASK_WORKER_INTERVAL=5
# Max retry attempts for failed tasks
RAG_TASK_MAX_RETRIES=3
# Enable worker (false = sync degraded mode, upload_file processes inline)
RAG_TASK_WORKER_ENABLED=true

# ═══════════════════════════════════════════════════════════
# Memory System Configuration (file-native)
# ═══════════════════════════════════════════════════════════
# Memory workspace directory (empty = <DATA_DIR>/memory)
MEMORY_WORKSPACE_DIR=
# auto_dream trigger threshold (daily cards count)
MEMORY_AUTO_DREAM_THRESHOLD=5
# auto_dream cron schedule (HH:MM, empty = disabled)
MEMORY_AUTO_DREAM_CRON=23:00
# auto_dream max units per run
MEMORY_AUTO_DREAM_MAX_UNITS=5
# Hybrid search top-K
MEMORY_SEARCH_TOP_K=10
# BM25 weight in RRF fusion
MEMORY_BM25_WEIGHT=0.3
# Vector search weight in RRF fusion (default: 0.7, vector + bm25 = 1.0)
MEMORY_VECTOR_WEIGHT=0.7
# Wikilink expansion weight in RRF fusion (DEPRECATED — wikilink no longer participates in RRF ranking)
MEMORY_WIKILINK_WEIGHT=0.3
# RRF k constant
MEMORY_RRF_K=60
# Vector chunk size (max characters per chunk)
MEMORY_CHUNK_SIZE=512
# Vector chunk minimum size (short adjacent chunks merged)
MEMORY_CHUNK_MIN_SIZE=100

# ═══════════════════════════════════════════════════════════
# Authentication (JWT + bcrypt)
# ═══════════════════════════════════════════════════════════
# JWT signing secret — MUST be at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Access token expiry (seconds). Default: 315360000 (10 years — effectively non-expiring).
# Session invalidates on backend restart (JWT secret regenerated) or manual logout.
JWT_ACCESS_TOKEN_EXPIRY=315360000

# Refresh token expiry (seconds). Default: 315360000 (10 years — effectively non-expiring).
JWT_REFRESH_TOKEN_EXPIRY=315360000

# Enable the password-only VIP shortcut on the login dialog and auth API
VIP_LOGIN_ENABLED=true

# Allow new user registration via /api/auth/register
ALLOW_REGISTRATION=true

# Default user for migration and VIP shortcut login
DEFAULT_USER_EMAIL=admin@local
DEFAULT_USER_PASSWORD=123456
# After changing the password, run:
# python -m scripts.reset_default_user_password

# ═══════════════════════════════════════════════════════════
# ReAct Loop (Custom SDK agents)
# ═══════════════════════════════════════════════════════════
# Enable the five-stage in-memory compaction pipeline (stages 1/2/3 at
# 0.70/0.80/0.88 ratios). Set to false to fall back to the legacy single-point
# _mid_run_compact (0.85 ratio, recent_keep=6, len-based success).
COMPACT_PIPELINE_ENABLED=true

# ═══════════════════════════════════════════════════════════
# Observability (OpenTelemetry + Arize Phoenix)
# ═══════════════════════════════════════════════════════════
# Enable/disable trace collection (all spans become no-op when false)
TRACE_ENABLED=true

# Phoenix OTLP gRPC endpoint (where spans are sent)
PHOENIX_ENDPOINT=http://localhost:4317

# Phoenix Web UI URL (for reference / linking)
PHOENIX_UI_URL=http://localhost:6006

# Online rule-based evaluation (runs automatically after each agent run)
EVAL_RULE_ENABLED=true

# Offline LLM-as-judge evaluation (manually triggered via API)
EVAL_JUDGE_ENABLED=false

# ─── Obsidian Sync ───
# Maximum transclusion depth for ![[note]] embedding
OBSIDIAN_MAX_EMBED_DEPTH=2
