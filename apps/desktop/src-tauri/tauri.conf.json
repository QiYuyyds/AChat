{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AChat",
  "version": "0.1.0",
  "identifier": "com.agenthub.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AChat",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": [
      "infra.default.json",
      "official.json",
      "resources/engine/**/*",
      "resources/ui/**/*"
    ],
    "externalBin": [],
    "longDescription": "AChat desktop: local static UI + local engine + direct infrastructure (default official, user-overridable).",
    "shortDescription": "AChat Desktop",
    "category": "DeveloperTool"
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://downloads.example.invalid/achat/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
