# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*

# Python virtual environments
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AgentHub runtime data
/.agenthub-data/
/.agenthub-data-e2e/
/.tmp/
/drizzle/

# Playwright
/playwright-report/
/test-results/

# Electron build outputs
/dist-electron/
/release/

# Mobile app build outputs
/apps/mobile/dist/

# IDE
.vscode/
.idea/
.qoder/

# Docs learning
/docs/learning/

# 待融合项目
/待融合项目/
/eval/CRUD_RAG-main/
/eval_memory/


/.claude
# Tauri / Rust build outputs
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Local debug dumps (may contain JWTs / session data)
.tmp_*
.tmp/

# Desktop packaged binaries & built static UI (generate via packaging scripts)
apps/desktop/resources/ui/
apps/desktop/src-tauri/resources/ui/
apps/desktop/src-tauri/resources/engine/**
!apps/desktop/src-tauri/resources/engine/.gitkeep
apps/desktop/src-tauri/resources/engine.bak/

# Desktop local infra overrides (defaults stay machine-local; do not commit secrets)
apps/desktop/configs/infra.default.*.json
apps/desktop/src-tauri/infra.default.json
