# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*

# Python virtual environments
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python cache & tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AgentHub runtime data
/.agenthub-data/
/.agenthub-data-e2e/
/.tmp/
/drizzle/

# CodeGraph local runtime data
/.codegraph/

# Playwright
/playwright-report/
/test-results/

# Electron build outputs
/dist-electron/
/release/

# Mobile app build outputs
/apps/mobile/dist/

# IDE
.vscode/
.idea/
.qoder/

